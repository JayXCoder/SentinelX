# ── Service ────────────────────────────────────────────────────────────────
APP_NAME=SentinelX Intelligence
SENTINELX_DEBUG=false
# Comma-separated allowed origins. Use * to allow all (dev only).
CORS_ORIGINS=http://localhost:4002,http://127.0.0.1:4002,http://localhost:3000,http://127.0.0.1:3000
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@postgres:5432/sentinelx

# ── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
# Leave blank for local/unauthenticated Qdrant
QDRANT_API_KEY=

# ── SGLang / Qwen ──────────────────────────────────────────────────────────
SGLANG_BASE_URL=http://sglang_qwen:30000
SGLANG_MODEL=Qwen/Qwen3.5-2B
SGLANG_TIMEOUT_SECONDS=120.0
SGLANG_MAX_RETRIES=3

# ── Embeddings ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384

# ── Redis Streams ──────────────────────────────────────────────────────────
STREAM_MAX_LEN=10000
STREAM_BLOCK_MS=5000

# ── Correlation Engine ─────────────────────────────────────────────────────
CORRELATION_TIME_WINDOW_HOURS=72
CORRELATION_MIN_SIGNALS=2

# ── Consumer Group ─────────────────────────────────────────────────────────
# Change CONSUMER_NAME per replica to avoid duplicate message delivery.
CONSUMER_GROUP=intelligence_layer
CONSUMER_NAME=intel_worker_1
