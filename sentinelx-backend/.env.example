# Hugging Face — required for gated/private models and higher rate limits
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# --- Running inside Docker Compose (service hostnames) ---
# DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@postgres:5432/sentinelx
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# SGLANG_BASE_URL=http://sglang_qwen:30000

# --- Running API on host against `docker compose` infra (localhost ports) ---
DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@localhost:4543/sentinelx
REDIS_URL=redis://localhost:4637/0
CELERY_BROKER_URL=redis://localhost:4637/0
CELERY_RESULT_BACKEND=redis://localhost:4637/1
QDRANT_URL=http://localhost:4633
SGLANG_BASE_URL=http://localhost:4300

# SGLang + Qwen
SGLANG_MODEL=Qwen/Qwen3.5-2B

# Bright Data — Web Unlocker API (recommended)
BRIGHT_DATA_ENABLED=false
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=sentinelx
# Or native proxy (zone Access details → username + password)
# BRIGHT_DATA_USERNAME=
# BRIGHT_DATA_PASSWORD=
# BRIGHT_DATA_HOST=brd.superproxy.io
# BRIGHT_DATA_PORT=33335

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384

CORS_ORIGINS=*
# Optional — when set, mutating routes require X-API-Key header
API_KEY=
RATE_LIMIT_PER_MINUTE=60
