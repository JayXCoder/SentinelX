# ══════════════════════════════════════════════════════════════════════════════
# SentinelX — root docker-compose environment
# Copy to .env and fill in secrets before running.
#   cp .env.example .env
#   docker compose up -d --build
# All variables have sane defaults for local dev; only override what differs.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx
POSTGRES_DB=sentinelx
POSTGRES_PORT=4543
# Shared connection URL (used by backend + intelligence services)
DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@postgres:5432/sentinelx

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PORT=4637
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_PORT=4633
QDRANT_URL=http://qdrant:6333
# Leave blank for local/unauthenticated; set for Qdrant Cloud
QDRANT_API_KEY=

# ── SGLang / Qwen (requires --profile ai or --profile full + NVIDIA GPU) ───
SGLANG_PORT=4300
SGLANG_BASE_URL=http://sglang_qwen:30000
SGLANG_MODEL=Qwen/Qwen3.5-2B
SGLANG_TIMEOUT_SECONDS=120.0
SGLANG_MAX_RETRIES=3
# Hugging Face token (needed to download gated models; compose maps HF_TOKEN → HUGGING_FACE_HUB_TOKEN)
HF_TOKEN=

# ── Bright Data (backend scraping — optional) ───────────────────────────────
# Mode A (recommended): Web Unlocker API — same as `curl https://api.brightdata.com/request`
# Skip Bright Data fetch when source was scraped within this many hours (reuse cached HTML)
SCRAPE_CACHE_HOURS=24

BRIGHT_DATA_ENABLED=false
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=sentinelx
# Mode B (alternative): native proxy username/password from zone Access details
# BRIGHT_DATA_USERNAME=brd-customer-...-zone-...
# BRIGHT_DATA_PASSWORD=
# BRIGHT_DATA_HOST=brd.superproxy.io
# BRIGHT_DATA_PORT=33335

# ── Service ports ──────────────────────────────────────────────────────────
BACKEND_PORT=4000
INTEL_PORT=4001
FRONTEND_PORT=4002

# ── Intelligence layer ─────────────────────────────────────────────────────
SENTINELX_DEBUG=false
CORS_ORIGINS=http://localhost:4002,http://127.0.0.1:4002,http://localhost:3000,http://127.0.0.1:3000
STREAM_MAX_LEN=10000
STREAM_BLOCK_MS=5000
CORRELATION_TIME_WINDOW_HOURS=72
CORRELATION_MIN_SIGNALS=2
CONSUMER_GROUP=intelligence_layer
CONSUMER_NAME=intel_worker_1

# ── API security (optional — when set, mutating routes require X-API-Key) ─
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# ── Frontend (browser → host ports; baked at image build time) ────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_INTELLIGENCE_API_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Server-only (Next.js proxy injects key; never expose in NEXT_PUBLIC_*)
SENTINELX_API_KEY=
API_BACKEND_URL=http://api:4000
API_INTELLIGENCE_URL=http://intelligence_api:4001

# Host ports (4000–4999): API=4000  Intelligence=4001  Frontend=4002  SGLang=4300
# PostgreSQL=4543  Redis=4637  Qdrant=4633
