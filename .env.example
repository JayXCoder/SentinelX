# Root docker-compose — copy to .env and adjust
#   cp .env.example .env
#   docker compose up -d --build

# Hugging Face (SGLang profile: --profile ai)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Bright Data scraping (backend)
BRIGHT_DATA_ENABLED=false
BRIGHT_DATA_USERNAME=
BRIGHT_DATA_PASSWORD=

# Frontend public URLs (browser → host ports; baked at image build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_INTELLIGENCE_API_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Host ports (4000–4999)
# API=4000  Intelligence=4001  Frontend=4002  SGLang=4300
# PostgreSQL=4543  Redis=4637  Qdrant=4633
