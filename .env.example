# ══════════════════════════════════════════════════════════════════════════════
# SentinelX — root docker-compose environment
# Copy to .env and fill in secrets before running.
# All variables have sane defaults for local dev; only override what differs.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx
POSTGRES_DB=sentinelx
POSTGRES_PORT=4543
# Shared connection URL (used by backend + intelligence services)
DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@postgres:5432/sentinelx

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PORT=4637
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_PORT=4633
QDRANT_URL=http://qdrant:6333
# Leave blank for local/unauthenticated; set for Qdrant Cloud
QDRANT_API_KEY=

# ── SGLang / Qwen (requires --profile ai or --profile full + NVIDIA GPU) ───
SGLANG_PORT=4300
SGLANG_BASE_URL=http://sglang_qwen:30000
SGLANG_MODEL=Qwen/Qwen3.5-2B
SGLANG_TIMEOUT_SECONDS=120.0
SGLANG_MAX_RETRIES=3
# Hugging Face token (needed to download gated models)
HF_TOKEN=

# ── Bright Data (Jay's backend scraping — optional) ────────────────────────
BRIGHT_DATA_ENABLED=false
BRIGHT_DATA_USERNAME=
BRIGHT_DATA_PASSWORD=

# ── Service ports ──────────────────────────────────────────────────────────
BACKEND_PORT=4000
INTEL_PORT=4001
FRONTEND_PORT=4002

# ── Intelligence layer (Kai Zhe) ───────────────────────────────────────────
SENTINELX_DEBUG=false
CORS_ORIGINS=*
STREAM_MAX_LEN=10000
STREAM_BLOCK_MS=5000
CORRELATION_TIME_WINDOW_HOURS=72
CORRELATION_MIN_SIGNALS=2
CONSUMER_GROUP=intelligence_layer
CONSUMER_NAME=intel_worker_1

# ── Frontend (Raymond + Geng Xin) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_INTELLIGENCE_API_URL=http://localhost:4001
