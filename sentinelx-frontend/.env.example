# SentinelX backend (Jay) — default host port 4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Backend WebSocket — live dashboard events (falls back to 30s polling if unreachable)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Kai Zhe intelligence service — default host port 4001 (future RAG/correlation)
NEXT_PUBLIC_INTELLIGENCE_API_URL=http://localhost:4001

# Server-only — injected by Next.js API proxy (never use NEXT_PUBLIC_* for secrets)
SENTINELX_API_KEY=
API_BACKEND_URL=http://localhost:4000
API_INTELLIGENCE_URL=http://localhost:4001
